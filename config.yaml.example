# Bundle Library Configuration File
# Location: ~/.config/bundle/config.yaml

# Pool configuration for centralized bundle storage
# Each pool represents a storage location where bundles can be imported
pools:
  # Default pool - used when no pool is specified
  default:
    root: /mnt/bundles
    title: Default Bundle Pool
  
  # Backup pool - for backup storage
  backup:
    root: /backup/bundles
    title: Backup Bundle Pool
  
  # Archive pool - for long-term archival
  archive:
    root: /archive/bundles
    title: Archive Pool

# Remote Bundle Servers, used with --remote and by push
# The url includes the API root. BUNDLE_TOKEN in the environment overrides token.
# Prefer https: a token sent over http can be read on the network.
default_remote: origin  # Used by push when --remote is not given
remotes:
  origin:
    url: https://bundles.example.org/api/v1
    token: replace-me
    pool: default  # Pool on the server; --remote-pool overrides it

# Logging configuration
log_level: info  # Options: debug, info, warn, error
